<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Portfolio Apex rules"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>Security, error-prone and performance rules for Apex.</description>
  <rule ref="category/apex/security.xml" />
  <rule ref="category/apex/errorprone.xml" />
  <rule ref="category/apex/performance.xml" />
  <rule ref="category/apex/bestpractices.xml">
    <exclude name="ApexAssertionsShouldIncludeMessage" />
    <exclude name="ApexUnitTestClassShouldHaveRunAs" />
  </rule>
  <rule ref="category/apex/codestyle.xml/ClassNamingConventions" />
  <rule ref="category/apex/codestyle.xml/MethodNamingConventions" />
  <rule ref="category/apex/design.xml/CyclomaticComplexity" />
  <rule ref="category/apex/design.xml/ExcessiveParameterList" />
</ruleset>
